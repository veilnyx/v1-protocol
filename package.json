{
  "name": "@zkfi-tech/v1-protocol",
  "version": "1.0.0",
  "description": "Smart contracts for zkfi v1 protocol",
  "scripts": {
    "clean": "rm -rf cache out",
    "build": "forge build",
    "test": "forge test",
    "coverage": "forge coverage --ir-minimum",
    "test:prepare": "ts-node test/fixtures/scripts/index.ts",
    "genAdpPayload": "forge script script/setup/GenerateAdaptorPayload.s.sol:GenerateAdaptorPayload",
    "deploy:test": "cross-env HARDHAT_FORK=true hardhat run script/deploy.ts --network hardhat",
    "upgrade:test": "cross-env HARDHAT_FORK=true HARDHAT_SHOW_STACK_TRACES=true HARDHAT_VERBOSE=true DEBUG=hardhat:* hardhat --verbose run script/upgrade.ts --network hardhat",
    "deploy:tenderly": "hardhat run script/deployTenderly.ts --network tenderlyMainnetCustomId",
    "deploy:sepolia": "hardhat run script/deploy.ts --network ethereumSepolia",
    "upgrade:ethSepolia": "hardhat run script/upgrade.ts --network ethereumSepolia",
    "upgrade:opSepolia": "hardhat run script/upgrade.ts --network optimismSepolia",
    "transferOwnership": "forge script script/setup/TransferOwnership.s.sol:TransferOwnership --broadcast",
    "genPoseidon": "npx tsx script/genPoseidon.ts",
    "registerCircuitNebra:ethSepolia": "hardhat run script/registerCircuitsOnNebra.ts --network ethereumSepolia"
  },
  "keywords": [],
  "author": "zkFi Team",
  "dependencies": {
    "@account-abstraction/contracts": "^0.7.0",
    "@chainlink/contracts": "^1.3.0",
    "@openzeppelin/contracts": "^5.0.2",
    "@openzeppelin/contracts-upgradeable": "^5.0.2",
    "poseidon-solidity": "^0.0.5"
  },
  "devDependencies": {
    "@nebrazkp/upa": "^2.0.3",
    "@nomicfoundation/hardhat-foundry": "^1.1.2",
    "@nomicfoundation/hardhat-ignition": "^0.15.5",
    "@nomicfoundation/hardhat-ignition-viem": "^0.15.5",
    "@nomicfoundation/hardhat-toolbox-viem": "^3.0.0",
    "@nomicfoundation/hardhat-viem": "^2.0.3",
    "@tenderly/hardhat-tenderly": "^2.3.0",
    "@types/node": "^20.11.16",
    "@zk-kit/imt.sol": "2.0.0-beta.12",
    "@zkfi-tech/account": "link:../v1-sdk/packages/account",
    "@zkfi-tech/babyjubjub": "link:../v1-sdk/packages/babyjubjub",
    "@zkfi-tech/core": "link:../v1-sdk/packages/core",
    "@zkfi-tech/shared-types": "link:../v1-sdk/packages/shared-types",
    "@zkfi-tech/transaction": "link:../v1-sdk/packages/transaction",
    "@zkfi-tech/utils": "link:../v1-sdk/packages/utils",
    "@zkfi-tech/zk-prover": "link:../v1-sdk/packages/zk-prover",
    "circomlibjs": "^0.1.7",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.5",
    "fixed-merkle-tree": "^0.7.3",
    "forge-std": "github:foundry-rs/forge-std#v1.8.2",
    "hardhat": "^2.22.8",
    "hardhat-contract-sizer": "^2.10.0",
    "permissionless": "^0.1.29",
    "snarkjs": "^0.7.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "viem": "^2.19.7"
  }
}