{
  "name": "@labyrinthac/v1-protocol",
  "version": "1.0.0",
  "description": "Smart contracts for zkfi v1 protocol",
  "scripts": {
    "clean": "rm -rf cache out",
    "build": "forge build",
    "test": "source .env && forge test --fork-url $RPC_ETHEREUM_MAINNET",
    "coverage": "source .env && forge coverage --no-match-coverage \"(script|test)/.*\" --fork-url $RPC_ETHEREUM_MAINNET --report summary",
    "test:prepare": "ts-node test/fixtures/scripts/index.ts",
    "genAdpPayload": "forge script script/setup/GenerateAdaptorPayload.s.sol:GenerateAdaptorPayload",
    "registerRevoker": "source .env && forge script script/setup/RegisterRevoker.s.sol:RegisterRevoker --rpc-url $RPC_ETHEREUM_SEPOLIA --broadcast",
    "deploy:test": "cross-env HARDHAT_FORK=true hardhat run script/deploy.ts --network hardhat",
    "upgrade:test": "cross-env HARDHAT_FORK=true HARDHAT_SHOW_STACK_TRACES=true HARDHAT_VERBOSE=true DEBUG=hardhat:* hardhat --verbose run script/upgrade.ts --network hardhat",
    "deployCoreWithAdp:tenderly": "hardhat run script/deployCoreWithAdp.ts --network tenderlyMainnetCustomId",
    "deployCoreWithAdp:sepolia": "hardhat run script/deployCoreWithAdp.ts --network sepolia",
    "deployCoreWithProofAggrInfra:sepolia": "hardhat run script/deployCoreWithProofAggrInfra.ts --network sepolia",
    "deployP-2-P:veilnyx": "hardhat run script/deployP-2-P.ts --network veilnyxTestnet",
    "deployP-2-P:arc": "hardhat run script/deployP-2-P.ts --network arcTestnet",
    "upgrade:ethSepolia": "hardhat run script/upgradePool.ts --network sepolia",
    "gen:upgradeCalldata": "hardhat run script/genUpgradeCalldata.ts --network sepolia",
    "upgradeMempool:ethSepolia": "hardhat run script/upgradeMempool.ts --network sepolia",
    "upgrade:opSepolia": "hardhat run script/upgrade.ts --network optimismSepolia",
    "transferOwnership": "forge script script/setup/TransferOwnership.s.sol:TransferOwnership --broadcast",
    "genPoseidon": "npx tsx script/genPoseidon.ts",
    "deployPaymaster:sepolia": "hardhat run script/deployPaymaster.ts --network sepolia",
    "paymasterOps:sepolia": "source .env && forge script script/setup/PaymasterOps.s.sol:PaymasterOps --rpc-url $RPC_ETHEREUM_SEPOLIA --broadcast",
    "registerCircuitNebra:ethSepolia": "hardhat run script/registerCircuitsOnNebra.ts --network sepolia"
  },
  "keywords": [],
  "author": "zkFi Team",
  "dependencies": {
    "@account-abstraction/contracts": "^0.7.0",
    "@chainlink/contracts": "^1.3.0",
    "@openzeppelin/contracts": "^5.0.2",
    "@openzeppelin/contracts-upgradeable": "^5.0.2",
    "poseidon-solidity": "^0.0.5"
  },
  "devDependencies": {
    "@labyrinthac/account": "link:../v1-sdk/packages/account",
    "@labyrinthac/babyjubjub": "link:../v1-sdk/packages/babyjubjub",
    "@labyrinthac/core": "link:../v1-sdk/packages/core",
    "@labyrinthac/shared-types": "link:../v1-sdk/packages/shared-types",
    "@labyrinthac/transaction": "link:../v1-sdk/packages/transaction",
    "@labyrinthac/utils": "link:../v1-sdk/packages/utils",
    "@labyrinthac/zk-prover": "link:../v1-sdk/packages/zk-prover",
    "@nebrazkp/upa": "^2.0.3",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-foundry": "^1.1.2",
    "@nomicfoundation/hardhat-ignition": "^0.15.5",
    "@nomicfoundation/hardhat-ignition-viem": "^0.15.5",
    "@nomicfoundation/hardhat-toolbox-viem": "^3.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.9",
    "@nomicfoundation/hardhat-viem": "^2.0.3",
    "@openzeppelin/hardhat-upgrades": "^3.9.0",
    "@tenderly/hardhat-tenderly": "^2.3.0",
    "@types/node": "^20.11.16",
    "@zk-kit/imt.sol": "2.0.0-beta.12",
    "circomlibjs": "^0.1.7",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.5",
    "fixed-merkle-tree": "^0.7.3",
    "forge-std": "github:foundry-rs/forge-std#v1.8.2",
    "hardhat": "^2.22.8",
    "hardhat-contract-sizer": "^2.10.0",
    "permissionless": "^0.1.29",
    "snarkjs": "^0.7.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "viem": "^2.19.7"
  }
}